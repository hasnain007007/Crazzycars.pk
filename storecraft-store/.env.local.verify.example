# Local mobile-API verification only. Copy to .env.local — NEVER point at production Mongo.
# DB must be on localhost and named with "local" or "verify".

MONGODB_URI=mongodb://127.0.0.1:27028/crazzycars_local_verify

# Fresh secrets for this laptop only (rotate anytime).
JWT_SECRET=local_verify_jwt_replace_me_with_openssl_rand_hex_64
MOBILE_JWT_SECRET=local_verify_mobile_jwt_replace_me_with_openssl_rand_hex_64

NEXT_PUBLIC_APP_NAME=Crazzycars.pk Local Verify
NEXT_PUBLIC_STORE_NAME=Crazzycars.pk Local Verify
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_STORE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_ADMIN_URL=
NEXT_PUBLIC_INDEXABLE=false
NEXT_PUBLIC_WHATSAPP=03000000000

REVALIDATE_SECRET=local-verify-revalidate
CRON_SECRET=local-verify-cron
AI_VISIT_INGEST_SECRET=local-verify-ai-visit

# Intentionally EMPTY — no Resend / Meta / PostEx / RunCourier in local verify
RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=CrazzyCars Local Verify
ADMIN_EMAIL=
POSTEX_API_KEY=
RUNCOURIER_API_KEY=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD=

SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
