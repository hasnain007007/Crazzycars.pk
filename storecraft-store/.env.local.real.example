# Local REAL catalog only — copy keys into .env.local (never Coolify / production).
# Requires: ./scripts/restore-catalog-local.sh ~/Desktop/cc-catalog.archive
# DB name must contain "local". Host must be 127.0.0.1.

MONGODB_URI=mongodb://127.0.0.1:27028/crazzycars_local_real

# Absolutize /media relative URLs to public HTTPS (emulator can load production media files).
MEDIA_PUBLIC_BASE_URL=https://crazzycars.pk
NEXT_PUBLIC_SITE_URL=https://crazzycars.pk
SITE_URL=https://crazzycars.pk
NEXT_PUBLIC_STORE_URL=https://crazzycars.pk

NEXT_PUBLIC_INDEXABLE=false

# Keep empty on this laptop
RESEND_API_KEY=
FROM_EMAIL=
POSTEX_API_KEY=
RUNCOURIER_API_KEY=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
