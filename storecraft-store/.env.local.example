MONGODB_URI=
JWT_SECRET=
NEXT_PUBLIC_APP_NAME=Crazzycars.pk
NEXT_PUBLIC_STORE_NAME=Crazzycars.pk
NEXT_PUBLIC_APP_URL=
SITE_URL=https://storecraft-store-iota.vercel.app
NEXT_PUBLIC_SITE_URL=https://storecraft-store-iota.vercel.app
# When the custom domain is attached, change BOTH to https://crazzycars.pk (or rely on
# request Host — discovery routes already use the Host header automatically).
# Set to "true" only on the live custom domain to allow Google indexing.
NEXT_PUBLIC_INDEXABLE=false
NEXT_PUBLIC_ADMIN_URL=
NEXT_PUBLIC_STORE_URL=https://storecraft-store-iota.vercel.app
NEXT_PUBLIC_WHATSAPP=
# Shared with storecraft-admin — POST /api/revalidate with x-revalidate-secret
REVALIDATE_SECRET=
RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=Crazzycars.pk
ADMIN_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD=
# Prefer NEXT_PUBLIC_CLOUDINARY_CLOUD; legacy CLOUDINARY_CLOUD_NAME still works.
# Production images are served from the VPS volume (no Cloudinary required):
MEDIA_ROOT=/app/media
# See docs/MEDIA-HOSTING.md

POSTEX_API_KEY=

# Meta Pixel + Conversions API (crazzycars.pk)
# Pixel ID can also live in Admin → Settings → SEO (facebookPixelId).
# META_PIXEL_ID=941277015101099
# META_CAPI_ACCESS_TOKEN=
# META_CAPI_TEST_EVENT_CODE=
# META_GRAPH_API_VERSION=v21.0

# Shared secret for /api/analytics/ai-visit ingest.
# Falls back to REVALIDATE_SECRET or CRON_SECRET. Middleware also uses trusted loopback ingest.
AI_VISIT_INGEST_SECRET=

# Hourly cron: /api/cron/blog (scheduled publish + auto view increase).
# Auth: Authorization: Bearer $CRON_SECRET (falls back to REVALIDATE_SECRET).
CRON_SECRET=

# Shopify Storefront API (Admin → Settings → Apps → Develop apps)
SHOPIFY_STORE_DOMAIN=ji46dz-hs.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Scopes: unauthenticated_read_product_listings, unauthenticated_read_product_inventory, unauthenticated_write_checkouts, unauthenticated_read_content
