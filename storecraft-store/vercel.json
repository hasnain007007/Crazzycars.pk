{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "storecraft-store-iota.vercel.app"
        }
      ],
      "destination": "https://crazzycars.pk/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/blog",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/abandoned-carts",
      "schedule": "0 * * * *"
    }
  ]
}
