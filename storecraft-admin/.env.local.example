# Homefy.pk local/dev — a SEPARATE database from CrazzyCars production.
# Never use Atlas cluster0 / sialkot_motorsports here.
MONGODB_URI=mongodb://127.0.0.1:27017/homefy
# Atlas alternative:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST.mongodb.net/homefy?retryWrites=true&w=majority

JWT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_STORE_URL=https://homefy.pk
SITE_URL=https://homefy.pk
NEXT_PUBLIC_SITE_URL=https://homefy.pk
NEXT_PUBLIC_TINYMCE_API_KEY=
# TinyMCE is no longer required — admin rich text uses TipTap (RichTextEditor).
