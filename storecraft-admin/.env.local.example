MONGODB_URI=
JWT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_TINYMCE_API_KEY=
# TinyMCE is no longer required — admin rich text uses TipTap (RichTextEditor).
# This env var is unused and can be left blank.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD=
# Cloudinary is optional/legacy. Production media uses the Coolify volume:
MEDIA_ROOT=/app/media
NEXT_PUBLIC_STORE_URL=https://crazzycars.pk
# See docs/MEDIA-HOSTING.md — mount the same volume on store + admin.

RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=Crazzycars.pk
POSTEX_API_KEY=
RUN_COURIER_API_KEY=
RUN_COURIER_CLIENT_CODE=
# RUN_COURIER_PROFILE_ID=
# Optional webhook secret for status callbacks (falls back to POSTEX_WEBHOOK_SECRET)
# RUN_COURIER_WEBHOOK_SECRET=
# Optional override (default https://portal.runcourier.com)
# RUN_COURIER_BASE_URL=

# Social Auto-Poster — see docs/social-autoposter.md
SOCIAL_ENABLED=false
SOCIAL_DRY_RUN=true
SOCIAL_TIMEZONE=Asia/Karachi
SOCIAL_DEFAULT_SLOTS=10:00,18:00
META_GRAPH_VERSION=v23.0
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_TOKEN=
PUBLIC_BASE_URL=https://crazzycars.pk
SOCIAL_MEDIA_DIR=social
TIKTOK_MODE=off
SOCIAL_ALERT_EMAIL=
