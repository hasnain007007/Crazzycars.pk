# MongoDB — Homefy.pk uses a dedicated empty database, never CrazzyCars production.
MONGODB_URI=mongodb://127.0.0.1:27017/homefy
# Atlas alternative: mongodb+srv://USER:PASSWORD@HOST.mongodb.net/homefy?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_very_long_random_secret_here
JWT_EXPIRY=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=StoreCraft Admin

# Postex status webhook (Header Key: X-Webhook-Secret → this value)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTEX_WEBHOOK_SECRET=

# Storefront (used for page preview links in admin — not the admin URL)
NEXT_PUBLIC_STORE_URL=https://homefy.pk

# Optional: storefront origin for CORS on /api/* (e.g. http://localhost:3001)
STOREFRONT_ORIGIN=
