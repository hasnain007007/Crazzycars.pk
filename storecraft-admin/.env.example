# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/storecraft

# JWT
JWT_SECRET=your_very_long_random_secret_here
JWT_EXPIRY=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=StoreCraft Admin

# Storefront (used for page preview links in admin — not the admin URL)
NEXT_PUBLIC_STORE_URL=https://thechaingang.eu

# Optional: storefront origin for CORS on /api/* (e.g. http://localhost:3001)
STOREFRONT_ORIGIN=
