<%- include('../partials/top') %>
<header class="page-head">
  <h1>Settings</h1>
  <p class="muted">Booking behaviour & city mappings</p>
</header>

<section class="grid-2">
  <form class="panel" method="post" action="/settings">
    <h2>Booking</h2>
    <label class="check">
      <input type="checkbox" name="autoBook" <%= settings.autoBook ? 'checked' : '' %> />
      Auto-book on Shopify webhook (AUTO_BOOK)
    </label>
    <label>Pickup address code
      <input name="pickupAddressCode" value="<%= settings.pickupAddressCode %>" required />
    </label>
    <button class="btn btn-primary" type="submit">Save</button>
  </form>

  <div class="panel">
    <h2>PostEx cities</h2>
    <p class="muted"><%= cityCount %> cities cached</p>
    <form method="post" action="/settings/refresh-cities">
      <button class="btn" type="submit">Refresh city cache</button>
    </form>
  </div>
</section>

<section class="panel" style="margin-top:1rem">
  <h2>City mappings</h2>
  <form method="post" action="/settings/mappings" class="filters">
    <input name="shopifyCityRaw" placeholder="Shopify city (e.g. lhr)" required />
    <select name="postexCityName" required>
      <option value="">PostEx city…</option>
      <% cities.forEach(function(c){ %>
        <option value="<%= c.name %>"><%= c.name %></option>
      <% }) %>
    </select>
    <button class="btn btn-primary" type="submit">Add mapping</button>
  </form>
  <table>
    <thead><tr><th>Shopify text</th><th>PostEx city</th><th></th></tr></thead>
    <tbody>
      <% if (!mappings.length) { %><tr><td colspan="3" class="muted">No manual mappings yet</td></tr><% } %>
      <% mappings.forEach(function(m){ %>
        <tr>
          <td class="mono"><%= m.shopifyCityRaw %></td>
          <td><%= m.postexCityName %></td>
          <td>
            <form method="post" action="/settings/mappings/<%= m.id %>/delete">
              <button class="btn btn-sm btn-danger" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('../partials/bottom') %>
